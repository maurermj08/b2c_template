# Copy this file to apps/readwriting/.env.local and fill in real values.
# .env.local is gitignored — your secrets stay local.

# ============================================
# Database
# ============================================
# SQLite (development — already set in .env)
# DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (production) — uncomment and set when deploying
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ============================================
# Auth.js
# ============================================
# Generate with: npx auth secret
AUTH_SECRET="replace-me-generate-with-npx-auth-secret"
# Required in production
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Anthropic API — Required for ReadWriting
# ============================================
ANTHROPIC_API_KEY="sk-ant-..."

# ============================================
# Email — Production Only
# ============================================
# RESEND_API_KEY="re_..."
# EMAIL_FROM="noreply@yourdomain.com"

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_NAME="ReadWriting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
