# Development defaults — safe to commit.
# Override any value by creating .env.local (gitignored).

# Database
DATABASE_URL="file:./prisma/dev.db"

# Auth.js
AUTH_SECRET="dev-only-secret-do-not-use-in-production"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="ReadWriting"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic API — required for handwriting transcription
# Set your real key in .env.local (never commit it here)
# ANTHROPIC_API_KEY=

# Email (production only)
# RESEND_API_KEY=
# EMAIL_FROM=
